 pub use iter_mtd::{NotifyDirectoryIteratorCancellable, NotifyDirectoryIteratorCanceller};
+
+/// Local patch (graphql-orm-storage): a QUERY_DIRECTORY reply must fit the
+/// output buffer the client requested (MS-SMB2 2.2.33, 3.3.5.18). A larger
+/// reply is refused before its entries are decoded.
+fn check_query_output_length(length: usize, requested: u32) -> crate::Result<()> {
+    if u32::try_from(length).map_or(true, |length| length > requested) {
+        return Err(Error::InvalidMessage(format!(
+            "Query directory reply of {length} bytes exceeds the requested {requested} bytes"
+        )));
+    }
+    Ok(())
+}
