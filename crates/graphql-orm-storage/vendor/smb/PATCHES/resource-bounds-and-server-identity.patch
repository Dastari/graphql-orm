+    use super::*;
+
+    #[::core::prelude::v1::test]
+    fn a_reply_larger_than_the_requested_buffer_is_refused() {
+        assert!(check_query_output_length(65_536, 65_536).is_ok());
+        assert!(check_query_output_length(0, 65_536).is_ok());
+        assert!(matches!(
+            check_query_output_length(65_537, 65_536),
+            Err(Error::InvalidMessage(_))
+        ));
+        assert!(matches!(
+            check_query_output_length(16 * 1024 * 1024, 65_536),
+            Err(Error::InvalidMessage(_))
+        ));
+    }
+}
